# Copiez ce fichier en ".env" puis adaptez les valeurs.

# --- Option A : API Gemini (cloud) ---------------------------------------
# Clé gratuite : https://aistudio.google.com/apikey
# Facultatif : la clé peut aussi être saisie dans l'application
# (Paramètres > Fournisseur). Une clé saisie dans l'application est prioritaire.
GEMINI_API_KEY=

# --- Option B : Ollama (local) -------------------------------------------
# Aucune clé nécessaire. Adresse par défaut du serveur Ollama :
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava

# --- Général (facultatif) -------------------------------------------------
# Fournisseur utilisé au premier lancement : gemini ou ollama
# (par défaut : gemini si une clé est présente, sinon ollama)
# DEFAULT_PROVIDER=ollama
# GEMINI_MODEL=gemini-3.5-flash
# PORT=5000
# FLASK_DEBUG=1
